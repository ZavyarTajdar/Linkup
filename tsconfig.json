{
  "compilerOptions": {
    /* Project Structure */
    "rootDir": "src",
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types", "./src/types"],

    /* Runtime */
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",

    /* Interop (NO MORE ERRORS LIKE dotenv, jwt, bcrypt) */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Strictness (Safe but not annoying) */
    "strict": true,
    "noImplicitAny": false,

    /* Node Environment */
    // REMOVED: "types": ["node"] <- Removing this lets TS read your typeRoots!

    /* Quality of Life */
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  /* Forces ts-node to read your custom .d.ts files during development */
  "ts-node": {
    "files": true
  },

  "include": ["src/**/*"], // Added/**/* to ensure all nested folders are tracked properly
  "exclude": ["node_modules", "dist"]
}